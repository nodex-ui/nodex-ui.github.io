<templates>
  <t t-name="examples.BlocksSidebar">
    <div class="b-blocks-sidebar-inner d-grid gap-4">
      <SidebarGroup>
        <SidebarGroupLabel><t t-esc="t('Feature blocks')"/></SidebarGroupLabel>
        <SidebarMenu>
          <SidebarMenuItem t-foreach="featureBlocks" t-as="block" t-key="block.name">
            <SidebarMenuButton href="'#/blocks/' + block.name" active="state.name === block.name">
              <t t-esc="block.label"/>
            </SidebarMenuButton>
          </SidebarMenuItem>
        </SidebarMenu>
      </SidebarGroup>

      <SidebarGroup>
        <SidebarGroupLabel><t t-esc="t('Sidebar blocks')"/></SidebarGroupLabel>
        <SidebarMenu>
          <SidebarMenuItem t-foreach="sidebarBlocks" t-as="block" t-key="block.name">
            <SidebarMenuButton href="'#/blocks/' + block.name" active="state.name === block.name">
              <t t-esc="block.label"/>
            </SidebarMenuButton>
          </SidebarMenuItem>
        </SidebarMenu>
      </SidebarGroup>

      <SidebarGroup>
        <SidebarGroupLabel><t t-esc="t('Auth blocks')"/></SidebarGroupLabel>
        <SidebarMenu>
          <SidebarMenuItem t-foreach="authBlocks" t-as="block" t-key="block.name">
            <SidebarMenuButton href="'#/blocks/' + block.name" active="state.name === block.name">
              <t t-esc="block.label"/>
            </SidebarMenuButton>
          </SidebarMenuItem>
        </SidebarMenu>
      </SidebarGroup>

      <SidebarGroup>
        <SidebarGroupLabel><t t-esc="t('Component demos')"/></SidebarGroupLabel>
        <SidebarMenu>
          <SidebarMenuItem t-foreach="componentDemoBlocks" t-as="block" t-key="block.name">
            <SidebarMenuButton href="'#/blocks/' + block.name" active="state.name === block.name">
              <t t-esc="block.label"/>
            </SidebarMenuButton>
          </SidebarMenuItem>
        </SidebarMenu>
      </SidebarGroup>
    </div>
  </t>

  <t t-name="examples.BlocksContent">
    <div>
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h5 mb-0" t-esc="block.label"/>
        <a class="btn btn-outline-secondary" t-att-href="'./blocks/' + block.name + '.html'">
          <Icon name="'external-link'"/>
          <t t-esc="t('Open block')"/>
        </a>
      </div>
      <iframe class="w-100 border rounded-3 bg-body" t-att-title="t('{label} preview', { label: block.label })" t-att-src="'./blocks/' + block.name + '.html?embed=1'" t-att-style="'height: ' + block.height + 'px'"></iframe>
    </div>
  </t>
</templates>
