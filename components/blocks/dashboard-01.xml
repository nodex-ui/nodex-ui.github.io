<templates>
  <t t-name="examples.SidebarBlock">
    <div b-block="dashboard-01">
      <Shell collapsed="state.collapsed" onCollapsedChange="(value) => { state.collapsed = value; }">
        <ShellSidebar>
          <ShellSidebarHeader>
            <a href="#" class="d-flex align-items-center gap-2 text-decoration-none fw-medium">
              <Icon name="'gallery-vertical-end'"/>
              Acme Inc.
            </a>
          </ShellSidebarHeader>
          <ShellNav>
            <SidebarMenu>
              <SidebarMenuItem><SidebarMenuButton href="'#'" icon="'layout-dashboard'" active="true">Dashboard</SidebarMenuButton></SidebarMenuItem>
              <SidebarMenuItem><SidebarMenuButton href="'#'" icon="'activity'">Lifecycle</SidebarMenuButton></SidebarMenuItem>
              <SidebarMenuItem><SidebarMenuButton href="'#'" icon="'chart-column'">Analytics</SidebarMenuButton></SidebarMenuItem>
              <SidebarMenuItem><SidebarMenuButton href="'#'" icon="'folder-kanban'">Projects</SidebarMenuButton></SidebarMenuItem>
              <SidebarMenuItem><SidebarMenuButton href="'#'" icon="'users'">Team</SidebarMenuButton></SidebarMenuItem>
            </SidebarMenu>
          </ShellNav>
        </ShellSidebar>
        <ShellMain>
          <ShellHeader className="'bg-body border-bottom px-4 py-2'">
            <SidebarTrigger/>
            <span class="fw-medium">Dashboard</span>
          </ShellHeader>
          <ShellContent className="'d-flex flex-column gap-3 gap-md-4 p-3 p-md-4'">
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3 g-md-4">
              <div class="col"><Card><CardBody><div class="text-body-secondary">Total Revenue</div><div class="h4 mb-0">$1,250.00</div></CardBody></Card></div>
              <div class="col"><Card><CardBody><div class="text-body-secondary">New Customers</div><div class="h4 mb-0">1,234</div></CardBody></Card></div>
              <div class="col"><Card><CardBody><div class="text-body-secondary">Active Accounts</div><div class="h4 mb-0">45,678</div></CardBody></Card></div>
              <div class="col"><Card><CardBody><div class="text-body-secondary">Growth Rate</div><div class="h4 mb-0">4.5%</div></CardBody></Card></div>
            </div>
            <Card>
              <CardHeader>
                <CardTitle>Total Visitors</CardTitle>
                <CardDescription>January - June 2026</CardDescription>
              </CardHeader>
              <CardBody>
                <Chart>
                  <div b-chart-plot="">
                    <div b-att-value="" style="--b-chart-value: 45%"></div>
                    <div b-att-value="" style="--b-chart-value: 70%"></div>
                    <div b-att-value="" style="--b-chart-value: 52%"></div>
                    <div b-att-value="" style="--b-chart-value: 86%"></div>
                    <div b-att-value="" style="--b-chart-value: 62%"></div>
                    <div b-att-value="" style="--b-chart-value: 75%"></div>
                    <div b-att-value="" style="--b-chart-value: 50%"></div>
                    <div b-att-value="" style="--b-chart-value: 90%"></div>
                    <div b-att-value="" style="--b-chart-value: 68%"></div>
                    <div b-att-value="" style="--b-chart-value: 58%"></div>
                    <div b-att-value="" style="--b-chart-value: 74%"></div>
                    <div b-att-value="" style="--b-chart-value: 48%"></div>
                    <div b-att-value="" style="--b-chart-value: 80%"></div>
                    <div b-att-value="" style="--b-chart-value: 57%"></div>
                    <div b-att-value="" style="--b-chart-value: 71%"></div>
                    <div b-att-value="" style="--b-chart-value: 64%"></div>
                    <div b-att-value="" style="--b-chart-value: 82%"></div>
                    <div b-att-value="" style="--b-chart-value: 55%"></div>
                  </div>
                </Chart>
              </CardBody>
            </Card>
            <Table responsive="true">
              <thead><tr><th>Header</th><th>Section Type</th><th>Status</th><th>Target</th></tr></thead>
              <tbody>
                <tr><td>Cover page</td><td>Cover</td><td><Badge variant="'success'">Done</Badge></td><td>18</td></tr>
                <tr><td>Table of contents</td><td>Table</td><td><Badge variant="'muted'">In Process</Badge></td><td>29</td></tr>
                <tr><td>Executive summary</td><td>Narrative</td><td><Badge variant="'primary'">Ready</Badge></td><td>10</td></tr>
              </tbody>
            </Table>
          </ShellContent>
        </ShellMain>
      </Shell>
    </div>
  </t>
</templates>
