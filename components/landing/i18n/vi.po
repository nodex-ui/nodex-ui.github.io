#: landing.js
msgid "No build step"
msgstr "Không cần bước build"

#: landing.js
msgid "One stylesheet and one script from jsDelivr or unpkg. Nothing to compile."
msgstr "Một stylesheet và một script từ jsDelivr hoặc unpkg. Không cần biên dịch."

#: landing.js
msgid "Two APIs, one source"
msgstr "Hai API, một nguồn"

#: landing.js
msgid "Pure Nodex UI <Button/> classes and base static markup (`b-ui`) share the same components."
msgstr "Lớp Base thuần <Button/> và markup tĩnh base (`b-ui`) dùng chung các thành phần."

#: landing.js
msgid "Modular"
msgstr "Mô-đun"

#: landing.js
msgid "Each component is self-contained. Use one or all 73, plus a full Lucide icon set."
msgstr "Mỗi thành phần độc lập. Dùng một hoặc cả 73, cùng bộ biểu tượng Lucide đầy đủ."

#: landing.js
msgid "Themeable"
msgstr "Tùy biến giao diện"

#: landing.js
msgid "--b-* design tokens with light and dark themes built in."
msgstr "Token thiết kế --b-* với giao diện sáng và tối có sẵn."

#: landing.js landing.xml
msgid "Docs"
msgstr "Tài liệu"

#: landing.js
msgid "Install paths, usage guides, and live previews for every component."
msgstr "Cách cài đặt, hướng dẫn sử dụng và bản xem trước trực tiếp cho mọi thành phần."

#: landing.js landing.xml
msgid "Blocks"
msgstr "Khối"

#: landing.js
msgid "Dashboards, sidebars, data tables, and auth screens ready to copy."
msgstr "Bảng điều khiển, thanh bên, bảng dữ liệu và màn hình xác thực sẵn sàng để sao chép."

#: landing.js
msgid "Icons"
msgstr "Biểu tượng"

#: landing.js
msgid "The full Lucide set through b-icon and the Icon component."
msgstr "Toàn bộ bộ Lucide qua b-icon và thành phần Icon."

#: landing.js
msgid "Charts"
msgstr "Biểu đồ"

#: landing.js
msgid "Bar, line, area, pie, radar and radial charts from native Nodex UI markup, plus Chart.js."
msgstr "Biểu đồ cột, đường, vùng, tròn, radar và vòng từ markup Nodex UI gốc, kèm Chart.js."

#: landing.js
msgid "Cookieless: no visitor ID leaves the browser, and nothing is sent until init()."
msgstr "Không cookie: mã khách truy cập không rời khỏi trình duyệt, và không gửi gì cho đến khi gọi init()."

#: landing.js
msgid "Standalone ~5.6 KB bundle with no framework or component runtime."
msgstr "Gói độc lập ~5,6 KB, không cần framework hay runtime thành phần."

#: landing.js
msgid "Automatic pageviews, including pushState and hash-routed SPAs."
msgstr "Tự động ghi nhận lượt xem trang, kể cả pushState và SPA dùng hash."

#: landing.js
msgid "Engagement: time on page and max scroll depth."
msgstr "Mức tương tác: thời gian trên trang và độ sâu cuộn tối đa."

#: landing.js
msgid "Outbound links, file downloads, form submits, and custom events with props and revenue."
msgstr "Liên kết ra ngoài, tải tệp, gửi biểu mẫu và sự kiện tùy chỉnh kèm thuộc tính và doanh thu."

#: landing.js
msgid "One POST route on your backend. Go Fiber and FastAPI samples ship with a ready-made dashboard."
msgstr "Chỉ một route POST trên backend. Mẫu Go Fiber và FastAPI đi kèm bảng điều khiển dựng sẵn."

#: landing.js
msgid "Renders an OpenAPI 3.x JSON file as browsable docs: grouped sidebar, parameters, request bodies, responses, callbacks."
msgstr "Hiển thị tệp JSON OpenAPI 3.x thành tài liệu duyệt được: thanh bên theo nhóm, tham số, nội dung yêu cầu, phản hồi, callback."

#: landing.js
msgid "Try It panel with request code samples in 17 languages and a Send API Request button."
msgstr "Bảng Try It với mã mẫu yêu cầu bằng 17 ngôn ngữ và nút Gửi yêu cầu API."

#: landing.js
msgid "Authorize dialog for API key, basic, bearer, OpenID Connect, and OAuth2 flows."
msgstr "Hộp thoại ủy quyền cho khóa API, basic, bearer, OpenID Connect và OAuth2."

#: landing.js
msgid "Markdown descriptions with Mermaid diagrams, light and dark themes, and linkable pages."
msgstr "Mô tả Markdown kèm sơ đồ Mermaid, giao diện sáng và tối, và các trang có thể liên kết."

#: landing.js
msgid "Standalone bundle: the runtime and its templates are embedded, so it needs no other Nodex UI script."
msgstr "Gói độc lập: runtime và các template được nhúng sẵn nên không cần script Nodex UI nào khác."

#: landing.js
msgid "Nodex UI is a CDN-installable kit of 73 Nodex UI components with built-in theming. Use them as pure Nodex UI components in your app, or as plain <code>b-ui</code> HTML markup on any page."
msgstr "Nodex UI là bộ 73 thành phần Base có sẵn giao diện theo chủ đề, cài đặt qua CDN. Dùng như thành phần Base thuần trong ứng dụng, hoặc như markup HTML <code>b-ui</code> trên bất kỳ trang nào."

#: landing.js
msgid "<code>nodexui/apidoc</code> turns any OpenAPI 3.x JSON document into interactive API docs. Use it as the <code>ApiDoc</code> Nodex UI component, as <code>b-ui=\"apidoc\"</code> markup, or as its own bundle."
msgstr "<code>nodexui/apidoc</code> biến mọi tài liệu JSON OpenAPI 3.x thành tài liệu API tương tác. Dùng như thành phần Base <code>ApiDoc</code>, như markup <code>b-ui=\"apidoc\"</code>, hoặc như một gói riêng."

#: landing.js
msgid "<code>nodexui/analytics</code> is a cookieless pageview and event tracker you can load on any page, with or without the rest of Nodex UI. Point it at your own backend and keep the data."
msgstr "<code>nodexui/analytics</code> là công cụ theo dõi lượt xem trang và sự kiện không dùng cookie, có thể nạp vào mọi trang, dùng riêng hoặc cùng Nodex UI. Trỏ nó về backend của bạn và giữ toàn quyền dữ liệu."

#: landing.js
msgid "Nodex UI — Ready-to-use UI components, straight from a CDN"
msgstr "Nodex UI — Thành phần giao diện dựng sẵn, nạp thẳng từ CDN"

