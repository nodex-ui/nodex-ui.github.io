#: docs.js
msgid "Usage Guide"
msgstr "Hướng dẫn sử dụng"

#: docs.js
msgid "The single entry point for integrating Nodex UI into a consumer project."
msgstr "Điểm vào duy nhất để tích hợp Nodex UI vào dự án sử dụng."

#: docs.js
msgid "Installation"
msgstr "Cài đặt"

#: docs.js
msgid "Install mechanics: CSS and JS files, load order, and CDN paths."
msgstr "Cơ chế cài đặt: tệp CSS và JS, thứ tự nạp và đường dẫn CDN."

#: docs.js
msgid "Theming"
msgstr "Giao diện"

#: docs.js
msgid "Set the theme on `html` or a subtree and override semantic tokens."
msgstr "Đặt giao diện trên `html` hoặc một nhánh con và ghi đè các token ngữ nghĩa."

#: docs.js
msgid "Runtime API"
msgstr "API Runtime"

#: docs.js
msgid "The `window.thebase` global: mount, mountAll, destroy, and events."
msgstr "Biến toàn cục `window.thebase`: mount, mountAll, destroy và các sự kiện."

#: docs.js
msgid "Analytics"
msgstr "Phân tích"

#: docs.js
msgid "Optional standalone, cookieless pageview and event tracking (`nodexui/analytics`)."
msgstr "Theo dõi lượt xem trang và sự kiện độc lập, không cookie, tùy chọn (`nodexui/analytics`)."

#: docs.js
msgid "i18n"
msgstr "i18n"

#: docs.js
msgid "Optional standalone gettext (.po) translations and language switching (`nodexui/i18n`)."
msgstr "Bản dịch gettext (.po) độc lập, tùy chọn, và chuyển đổi ngôn ngữ (`nodexui/i18n`)."

#: docs.js
msgid "Skill for AI"
msgstr "Kỹ năng cho AI"

#: docs.js
msgid "Install the Nodex UI agent skill so Claude Code builds apps and components with Nodex UI."
msgstr "Cài kỹ năng agent Nodex UI để Claude Code xây dựng ứng dụng và thành phần bằng Nodex UI."

#: docs.js
msgid "Registry"
msgstr "Registry"

#: docs.js
msgid "How `dist/nodexui.registry.json` describes every shipped component."
msgstr "Cách `dist/nodexui.registry.json` mô tả từng thành phần được phát hành."

#: docs.js
msgid "Nodex UI Component"
msgstr "Thành phần Base"

#: docs.js
msgid "Import real component classes instead of the static `b-ui` markers."
msgstr "Nhập các lớp thành phần thật thay cho dấu `b-ui` tĩnh."

#: docs.js
msgid "Component Authoring"
msgstr "Viết thành phần"

#: docs.js
msgid "How components implement both the static and pure Nodex UI public APIs."
msgstr "Cách thành phần hiện thực cả API tĩnh và API Base thuần."

#: docs.js
msgid "Blocks"
msgstr "Khối"

#: docs.js
msgid "Static HTML block compositions styled by the shadcn-aligned tokens."
msgstr "Các khối HTML tĩnh được tạo kiểu bằng token theo chuẩn shadcn."

#: docs.js
msgid "Built-in Icons"
msgstr "Biểu tượng tích hợp"

#: docs.js
msgid "Use the bundled Lucide icon library from plain HTML or JavaScript."
msgstr "Dùng thư viện biểu tượng Lucide đi kèm từ HTML hoặc JavaScript thuần."

#: docs.js
msgid "Unable to load Nodex UI registry."
msgstr "Không thể tải registry Nodex UI."

